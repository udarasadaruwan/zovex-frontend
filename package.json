    "react-router-dom": "^7.1.1",
    "vite": "^6.0.7"
  },
  "devDependencies": {
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "gh-pages": "^6.3.0",
    "typescript": "^6.0.3"
  }
}
